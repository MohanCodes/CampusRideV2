# Copy to .env.local and fill in. Never commit real values.
# Names and where each one lives: BUILD.md Section 3.

# Web app (Vercel and .env.local). Public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SITE_URL=
SENTRY_DSN=

# These live only in Supabase (Edge Function secrets and Vault), never here or in Vercel:
#   RESEND_API_KEY, EMAIL_FROM, EMAIL_FUNCTION_SECRET   (Edge Function secrets)
#   email_function_url, email_function_secret           (Vault secrets read by the cron job)
# The Supabase service role key is never set in this app, in any NEXT_PUBLIC_* variable, or in logs.
